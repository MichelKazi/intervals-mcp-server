    "@testing-library/react": "^14.2.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jest-axe": "^9.0.0",
    "@types/jest-axe": "^3.5.9",
    "jsdom": "^24.0.0",
    "style-dictionary": "^4.3.0",
