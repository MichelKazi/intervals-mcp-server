{
  "name": "@coaching/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/generated/tokens.ts",
    "./tailwind": "./tailwind.config.ts",
    "./styles": "./src/styles/globals.css",
    "./variables.css": "./src/tokens/generated/variables.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
