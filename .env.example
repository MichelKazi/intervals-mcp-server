# Intervals.icu API Configuration

# Base URL (Optional, defaults to https://intervals.icu/api/v1)
# INTERVALS_API_BASE_URL=https://intervals.icu/api/v1

# Required: Your Intervals.icu API Key
API_KEY=your_intervals_api_key_here

# Required: Your Intervals.icu Athlete ID
ATHLETE_ID=your_athlete_id_here

# The API_KEY and ATHLETE_ID will be used as defaults for all API calls
# when these parameters are not explicitly provided to the tool functions.

# TrainerRoad Integration (Optional)
# Preferred: username/password — auto-login, no manual cookie management
TRAINERROAD_USERNAME=your_trainerroad_email
TRAINERROAD_PASSWORD=your_trainerroad_password

# Optional: cache your TR member ID to skip a validation roundtrip on startup.
# Find it at api.trainerroad.com/api/members (MemberId field) or in dev tools.
# TRAINERROAD_MEMBER_ID=151360

# Fallback: manual cookie from browser dev tools (expires, not recommended)
# TRAINERROAD_COOKIE=SharedTrainerRoadAuth=...

# Brain MCP Integration (Optional)
# Enables shared Supabase tables for wellness journal, risk flags, and coaching principles.
# Without these, the server works exactly as before — all integration is additive.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web API (Optional)
# Bearer token for the HTTP API. If unset or empty, the web API is unauthenticated.
WEB_API_TOKEN=

# CORS origin for the web API. Default is * (all origins).
WEB_ALLOWED_ORIGIN=
